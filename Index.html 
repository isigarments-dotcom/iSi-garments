}
.acc-head:hover{padding-left:16px;color:#3f5a2a}
.acc-head i{
  position:relative;flex:0 0 34px;width:34px;height:34px;border-radius:50%;
  border:1px solid rgba(17,26,23,.25);
  transition:background .35s ease,border-color .35s ease,transform .45s var(--ease);
}
.acc-head i::before,.acc-head i::after{
