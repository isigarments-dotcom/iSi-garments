.acc-head i::after{width:1.5px;height:12px;transform:translate(-50%,-50%)}
.acc-item.open .acc-head i{background:var(--green);border-color:var(--green);transform:rotate(180deg)}
.acc-item.open .acc-head i::after{transform:translate(-50%,-50%) rotate(90deg);opacity:0}
